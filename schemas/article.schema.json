{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procelyx.cz/schemas/article.schema.json",
  "title": "content/articles/<slug>.json Ă˘â‚¬â€ť article published from Nexus One (nexus.article.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "version",
    "nexusId",
    "title",
    "seoTitle",
    "description",
    "category",
    "typeLabel",
    "lead",
    "teaser",
    "bodyHtml",
    "faq",
    "related",
    "image",
    "cta",
    "keywords",
    "aiNote",
    "datePublished",
    "dateModified"
  ],
  "properties": {
    "schema": {
      "const": "nexus.article.v1"
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "nexusId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140,
      "pattern": "^[^<>]*$"
    },
    "seoTitle": {
      "type": "string",
      "minLength": 10,
      "maxLength": 70,
      "pattern": "^[^<>]*$"
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 160,
      "pattern": "^[^<>]*$"
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "pattern": "^[^<>]*$"
    },
    "typeLabel": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "pattern": "^[^<>]*$"
    },
    "lead": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "pattern": "^[^<>]*$"
    },
    "teaser": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300,
      "pattern": "^[^<>]*$"
    },
    "bodyHtml": {
      "type": "string",
      "minLength": 200,
      "maxLength": 80000
    },
    "faq": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "pattern": "^[^<>]*$"
          },
          "a": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "pattern": "^[^<>]*$"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "image": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mediaId",
        "alt"
      ],
      "properties": {
        "mediaId": {
          "type": "string",
          "pattern": "^img-[a-z0-9-]{1,160}$"
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "cta": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "text",
        "label",
        "href"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^<>]*$"
        },
        "text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[^<>]*$"
        },
        "href": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(/[A-Za-z0-9/_.#?=&%:~+-]*|https://[A-Za-z0-9.-]+\\.[A-Za-z]{2,}[^\\s\"'<>]*)$"
        }
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60,
        "pattern": "^[^<>]*$"
      }
    },
    "aiNote": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 5,
      "maxLength": 300,
      "pattern": "^[^<>]*$"
    },
    "datePublished": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateModified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "assets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId",
          "mime",
          "dataBase64",
          "width",
          "height"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "pattern": "^img-nexus-[a-f0-9]{64}$"
          },
          "mime": {
            "const": "image/webp"
          },
          "dataBase64": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600000,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "width": {
            "type": "integer",
            "minimum": 800,
            "maximum": 1600
          },
          "height": {
            "type": "integer",
            "minimum": 400,
            "maximum": 900
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId",
          "kind",
          "alt",
          "afterSection"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "pattern": "^img-[a-z0-9-]{1,160}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "illustration",
              "infographic"
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300,
            "pattern": "^[^<>]*$"
          },
          "afterSection": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    }
  }
}
