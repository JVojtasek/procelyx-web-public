{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procelyx.cz/schemas/manifest.schema.json",
  "title": "content/manifest.json — contract nexus.site.v1 (see contract/nexus.site.v1.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site", "pages"],
  "properties": {
    "schema": { "const": "nexus.site.v1" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "languages", "defaultLanguage"],
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cs", "en"] } },
        "defaultLanguage": { "enum": ["cs", "en"] }
      }
    },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-zA-Z0-9-]+)*$", "maxLength": 80 },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "file", "label", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$" },
        "file": { "type": "string", "pattern": "^public/[A-Za-z0-9/_-]+\\.html$" },
        "label": { "$ref": "#/$defs/label" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "selector", "tier", "i18n", "derivedAssets", "affectsLegal"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "paragraph", "seo.title", "seo.description", "image"] },
        "label": { "$ref": "#/$defs/label" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 200 },
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$" },
        "siteKey": { "enum": ["email", "phone", "founderName", "founderTitle", "seoTitle", "seoDescription", "businessId", "businessSeat"] },
        "mediaKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$" },
        "altKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}\\.alt$" },
        "minLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "tier": { "enum": ["T2", "T3", "DEV", "NEVER"] },
        "i18n": { "type": "boolean" },
        "related": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "derivedAssets": { "type": "array", "uniqueItems": true, "items": { "enum": ["vcard", "qr", "vizitka-png", "og-image", "json-ld"] } },
        "affectsLegal": { "type": "boolean" }
      }
    }
  }
}
