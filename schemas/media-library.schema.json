{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procelyx.cz/schemas/media-library.schema.json",
  "title": "content/media-library.json — raster images available to image slots (generated by the build)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^img-[a-z0-9-]{1,160}$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height"],
      "properties": {
        "path": { "type": "string", "pattern": "^/images/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.(jpg|jpeg|png|webp)$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
