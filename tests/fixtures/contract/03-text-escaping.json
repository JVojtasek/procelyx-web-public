{
  "name": "03-text-escaping",
  "note": "text is escaped, never parsed as HTML",
  "html": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"></head><body><p data-t=\"p\">x</p></body></html>",
  "content": {
    "i18n": {
      "cs": {
        "p": "A & B \"C\" 'D'"
      },
      "en": {
        "p": "A & B"
      }
    },
    "site": {
      "seoTitle": {
        "cs": "Titulek CZ",
        "en": "Title EN"
      },
      "seoDescription": {
        "cs": "Popis stránky CZ pro vyhledávače.",
        "en": "Page description EN."
      },
      "email": "info@example.com",
      "phone": "+420 000 000 000",
      "founderName": "Jan Novák",
      "businessId": "12345678"
    },
    "media": {},
    "library": {
      "img-a-webp": {
        "path": "/images/a.webp",
        "width": 1200,
        "height": 800
      },
      "img-b-jpg": {
        "path": "/images/b.jpg",
        "width": 640,
        "height": 480
      }
    }
  },
  "manifest": {
    "schema": "nexus.site.v1",
    "site": {
      "baseUrl": "https://example.com",
      "languages": [
        "cs",
        "en"
      ],
      "defaultLanguage": "cs"
    },
    "pages": [
      {
        "id": "home",
        "path": "/",
        "file": "public/index.html",
        "label": "Úvodní stránka",
        "sections": [
          {
            "id": "home.main",
            "label": "Hlavní",
            "slots": [
              {
                "id": "home.main.p",
                "key": "p",
                "type": "text",
                "label": "p",
                "selector": "[data-slot=\"home.main.p\"]",
                "minLength": 1,
                "maxLength": 200,
                "tier": "T2",
                "i18n": true,
                "derivedAssets": [],
                "affectsLegal": false
              }
            ]
          }
        ]
      }
    ]
  },
  "expectedHtml": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"></head><body><p data-t=\"p\" data-slot=\"home.main.p\">A &amp; B \"C\" 'D'</p></body></html>"
}
