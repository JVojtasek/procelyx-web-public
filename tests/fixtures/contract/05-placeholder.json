  "expectedHtml": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"></head><body><textarea data-ph=\"ph\" placeholder=\"Např. …\"></textarea><h1 data-t=\"h1\" data-slot=\"home.main.h1\">Nadpis</h1></body></html>"
}
