{
  "name": "08-image-swap",
  "note": "changing mediaId swaps the picture and its dimensions",
  "html": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"></head><body><img class=\"caseImage\" data-slot=\"home.cases.1.image\" src=\"/images/a.webp\" alt=\"A\" width=\"1200\" height=\"800\" data-alt=\"caseImage1.alt\"></body></html>",
