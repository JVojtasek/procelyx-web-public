  "expectedHtml": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"></head><body><img class=\"caseImage\" data-slot=\"home.cases.1.image\" src=\"/images/b.jpg\" alt=\"Nový popis\" width=\"640\" height=\"480\" data-alt=\"caseImage1.alt\"></body></html>"
}
