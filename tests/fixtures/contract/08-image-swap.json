              {
                "id": "home.cases.1.image",
                "type": "image",
                "label": "caseImage1",
                "selector": "[data-slot=\"home.cases.1.image\"]",
                "mediaKey": "caseImage1",
                "altKey": "caseImage1.alt",
                "tier": "T2",
                "i18n": true,
                "derivedAssets": [],
                "affectsLegal": false
              }
            ]
          }
        ]
      }
    ]
