{
  "name": "10-english",
  "note": "lang \"en\" injects the English dictionary (Nexus preview of the EN version)",
  "lang": "en",
  "html": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"><title>Old</title><meta name=\"description\" content=\"old\"></head><body><h1 data-t=\"h1\">x</h1></body></html>",
  "content": {
    "i18n": {
      "cs": {
        "h1": "Nadpis"
      },
      "en": {
        "h1": "Heading"
      }
    },
    "site": {
      "seoTitle": {
        "cs": "Titulek CZ",
        "en": "Title EN"
      },
      "seoDescription": {
        "cs": "Popis stránky CZ pro vyhledávače.",
        "en": "Page description EN."
      },
      "email": "info@example.com",
      "phone": "+420 000 000 000",
      "founderName": "Jan Novák",
      "businessId": "12345678"
    },
    "media": {},
    "library": {
      "img-a-webp": {
        "path": "/images/a.webp",
        "width": 1200,
        "height": 800
      },
      "img-b-jpg": {
        "path": "/images/b.jpg",
        "width": 640,
        "height": 480
      }
    }
  },
  "manifest": {
    "schema": "nexus.site.v1",
    "site": {
      "baseUrl": "https://example.com",
      "languages": [
        "cs",
        "en"
      ],
      "defaultLanguage": "cs"
    },
    "pages": [
      {
        "id": "home",
        "path": "/",
        "file": "public/index.html",
        "label": "Úvodní stránka",
        "sections": [
          {
            "id": "home.main",
            "label": "Hlavní",
            "slots": [
              {
                "id": "home.seo.title",
                "type": "seo.title",
                "label": "Titulek",
                "selector": "title",
                "siteKey": "seoTitle",
                "minLength": 5,
                "maxLength": 70,
                "tier": "T2",
                "i18n": true,
                "derivedAssets": [],
                "affectsLegal": false
              },
              {
                "id": "home.seo.description",
                "type": "seo.description",
                "label": "Popis",
                "selector": "meta[name=\"description\"]",
                "siteKey": "seoDescription",
                "minLength": 5,
                "maxLength": 170,
                "tier": "T2",
                "i18n": true,
                "derivedAssets": [],
                "affectsLegal": false
              },
              {
                "id": "home.main.h1",
                "key": "h1",
                "type": "text",
                "label": "h1",
                "selector": "[data-slot=\"home.main.h1\"]",
                "minLength": 1,
                "maxLength": 200,
                "tier": "T2",
                "i18n": true,
                "derivedAssets": [],
                "affectsLegal": false
              }
            ]
          }
        ]
      }
    ]
  },
  "expectedHtml": "<!DOCTYPE html><html lang=\"cs\"><head><meta charset=\"utf-8\"><title>Title EN</title><meta name=\"description\" content=\"Page description EN.\"></head><body><h1 data-t=\"h1\" data-slot=\"home.main.h1\">Heading</h1></body></html>"
}
